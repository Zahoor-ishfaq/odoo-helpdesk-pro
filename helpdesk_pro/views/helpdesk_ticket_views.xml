<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
                    <field
                        name="stage_id"
                        widget="statusbar"
                        options="{'clickable': '1'}"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <span class="o_form_label text-muted">
                            <field name="ref" readonly="1"/>
                        </span>
                        <h1>
                            <field name="name" placeholder="Subject..."/>
                        </h1>
                        <div class="o_row">
                            <field name="priority" widget="priority"/>
                        </div>
                    </div>
                    <group string="SLA" invisible="not sla_id">
                        <field name="sla_id" readonly="1"/>
                        <field name="sla_deadline" readonly="1"/>
                        <field
                            name="sla_status"
                            widget="badge"
                            decoration-success="sla_status == 'ok'"
                            decoration-warning="sla_status == 'at_risk'"
                            decoration-danger="sla_status == 'breached'"
                        />
                    </group>
                    <group>
                        <group>
                            <field name="team_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="partner_id"/>
                            <field name="partner_email"/>
                            <field name="partner_name"/>
                        </group>
                        <group>
                            <field
                                name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color'}"
                            />
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <!-- PORT-19: replace this div with <chatter/> -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- PORT-19: <tree> becomes <list> -->
    <record id="helpdesk_ticket_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <tree
                string="Tickets"
                multi_edit="1"
                decoration-danger="sla_status == 'breached'"
                decoration-warning="sla_status == 'at_risk'"
                decoration-success="sla_status == 'ok'"
            >
                <field name="ref"/>
                <field name="name"/>
                <field name="team_id" optional="show"/>
                <field name="user_id" optional="show" widget="many2one_avatar_user"/>
                <field name="priority" optional="show" widget="priority"/>
                <field name="tag_ids" widget="many2many_tags" optional="hide"/>
                <field name="stage_id" optional="show"/>
                <field name="sla_status" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="helpdesk_ticket_view_kanban" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban
                default_group_by="stage_id"
                class="o_kanban_small_column"
                quick_create="false"
            >
                <field name="stage_id"/>
                <field name="priority"/>
                <field name="color"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="tag_ids"/>
                <field name="team_id"/>
                <field name="sla_status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="oe_kanban_card oe_kanban_global_click #{kanban_color(record.color.raw_value)}"
                        >
                            <div class="oe_kanban_content">
                                <div class="o_dropdown_kanban dropdown">
                                    <a
                                        role="button"
                                        class="dropdown-toggle o-no-caret btn"
                                        data-bs-toggle="dropdown"
                                        href="#"
                                        aria-label="Dropdown menu"
                                        title="Dropdown menu"
                                    >
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <ul
                                            class="oe_kanban_colorpicker"
                                            data-field="color"
                                            role="menu"
                                        />
                                    </div>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="ref"/> - <field name="name"/>
                                    </strong>
                                    <div>
                                        <field name="partner_id"/>
                                    </div>
                                    <div class="o_kanban_tags_section">
                                        <field
                                            name="tag_ids"
                                            widget="many2many_tags"
                                            options="{'color_field': 'color'}"
                                        />
                                    </div>
                                    <div t-if="record.sla_status.raw_value" class="mt-1">
                                        <span
                                            t-if="record.sla_status.raw_value == 'breached'"
                                            class="badge text-bg-danger"
                                        >SLA Breached</span>
                                        <span
                                            t-elif="record.sla_status.raw_value == 'at_risk'"
                                            class="badge text-bg-warning"
                                        >SLA At Risk</span>
                                        <span
                                            t-elif="record.sla_status.raw_value == 'ok'"
                                            class="badge text-bg-success"
                                        >SLA On Track</span>
                                    </div>
                                    <div
                                        class="d-flex justify-content-between align-items-center mt-2"
                                    >
                                        <field name="priority" widget="priority"/>
                                        <field
                                            name="user_id"
                                            widget="many2one_avatar_user"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="helpdesk_ticket_view_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="Tickets">
                <field name="name" string="Ticket"/>
                <field name="ref"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="tag_ids"/>
                <filter string="My Tickets" name="my_tickets" domain="[('user_id', '=', uid)]"/>
                <filter
                    string="Unassigned"
                    name="unassigned"
                    domain="[('user_id', '=', False)]"
                />
                <filter
                    string="SLA Breached"
                    name="sla_breached"
                    domain="[('sla_status', '=', 'breached')]"
                />
                <filter
                    string="SLA At Risk"
                    name="sla_at_risk"
                    domain="[('sla_status', '=', 'at_risk')]"
                />
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Team" name="group_by_team" context="{'group_by': 'team_id'}"/>
                    <filter
                        string="Stage"
                        name="group_by_stage"
                        context="{'group_by': 'stage_id'}"
                    />
                    <filter
                        string="Assignee"
                        name="group_by_user"
                        context="{'group_by': 'user_id'}"
                    />
                    <filter
                        string="Priority"
                        name="group_by_priority"
                        context="{'group_by': 'priority'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="helpdesk_ticket_action" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="helpdesk_ticket_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first helpdesk ticket
            </p>
        </field>
    </record>
</odoo>
